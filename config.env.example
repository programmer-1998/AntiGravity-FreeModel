# ==============================================================================
# AntiGravity-FreeModel / Auto-Orchestrator Configuration
# ==============================================================================
# Copy this file to `config.env` and insert your API keys:
#     cp config.env.example config.env
#
# NOTE: Never commit your actual `config.env` file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Groq API Key (Recommended - Free Tier Available)
# ------------------------------------------------------------------------------
# Get your free key at: https://console.groq.com/keys
# Powers lightning-fast models:
#   - openai/gpt-oss-120b
#   - qwen/qwen3.8-27b
GROQ_API_KEY=gsk_your_groq_api_key_here

# ------------------------------------------------------------------------------
# 2. OpenRouter API Key (Recommended - Free Models Available)
# ------------------------------------------------------------------------------
# Get your key at: https://openrouter.ai/settings/keys
# Powers top free tier models:
#   - nvidia/nemotron-3-ultra-550b-a55b:free (Deep reasoning)
#   - cohere/north-mini-code:free (Code generation & debugging)
#   - google/gemma-4-31b-it:free (General knowledge)
#   - nvidia/nemotron-3.5-lightning:free (Fast responses)
#   - poolside/laguna-s-2.1:free
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# ------------------------------------------------------------------------------
# 3. Optional Paid External Provider Keys
# ------------------------------------------------------------------------------
# Only needed if you specifically route tasks to direct OpenAI / Anthropic APIs
# instead of using OpenRouter or Free models.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
